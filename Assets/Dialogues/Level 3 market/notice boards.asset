  m_Script: {fileID: 11500000, guid: 807113cb1a76e7447b723d8ea432b47d, type: 3}
  m_Name: notice boards
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: 'Multiple signs on notice board says : '
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: '"JOIN THE ARMY! Once-in-a-lifetime opportunity to fight in the war! Join
      quick, before we come to your house"'
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: 'VOLUNTEER TODAY! Not feeling like volunteering? Great news: our recruiters
      can volunteer you'
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: 'Sign-up bonus: a free pat on the back! Delivered by a very large man,
      immediately, whether you''ve signed or not'
