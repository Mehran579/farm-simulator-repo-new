  m_Script: {fileID: 11500000, guid: 807113cb1a76e7447b723d8ea432b47d, type: 3}
  m_Name: angel talk
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: You..?
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: You are an angel right?
  - speaker: Bilbically Accurate Angel
    portrait: {fileID: -7337615845406242586, guid: 7bc1d3b6533da4b44bfdfbe3268b641a, type: 3}
    text: Indeed, child. Speak thy mind, and ask whatever doth trouble thy thoughts.
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: Can you tell me What's the Meaning of life?
  - speaker: Bilbically Accurate Angel
    portrait: {fileID: -7337615845406242586, guid: 7bc1d3b6533da4b44bfdfbe3268b641a, type: 3}
    text: fuh nuh gng, I ain't got a damn clue about all that. I am just the dev's
      projection
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: what even is the point of you being here T~T
  - speaker: Dev Angel
    portrait: {fileID: -7337615845406242586, guid: 7bc1d3b6533da4b44bfdfbe3268b641a, type: 3}
    text: Am here to give you your long awaited plot twist
  - speaker: Edmund Chamar
    portrait: {fileID: -984164299818982976, guid: 1caf50aa47e18214b94fb3ee8bee0004, type: 3}
    text: FINALLLLYYY!!!!
